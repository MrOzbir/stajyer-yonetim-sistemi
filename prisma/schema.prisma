generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- KULLANICI ROLLERİ ---
enum Role {
  ADMIN
  INTERN
}

// --- GÖREV DURUMLARI ---
enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

// 1. KULLANICILAR TABLOSU (Güncellendi)
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  surname   String    @default("")
  password_hash String	
  role      Role     @default(INTERN)
  createdAt DateTime @default(now())
  
  // Mevcut İlişkiler
  profile       InternProfile?
  tasksGiven    Task[]  @relation("AdminTasks")
  tasksReceived Task[]  @relation("InternTasks")

  // YENİ: Log, Arşiv ve Mesajlaşma İlişkileri
  logs             DailyLog[]     @relation("InternLogs")
  archives         DailyArchive[] @relation("InternArchives")
  sentMessages     Message[]      @relation("SentMessages")
  receivedMessages Message[]      @relation("ReceivedMessages")

  aiReports      AiReport[]     @relation("InternAiReports")
}

// 2. STAJYER PROFİLİ TABLOSU
model InternProfile {
  id         Int       @id @default(autoincrement())
  university String?
  major      String?
  startDate  DateTime?
  endDate    DateTime?

  userId     Int       @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 3. GÖREVLER TABLOSU
model Task {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  deadline      DateTime?
  repoLink    String?    // YENİ: Stajyerin ekleyeceği Github/Gitlab linki
  status      TaskStatus @default(PENDING)
  createdAt   DateTime   @default(now())

  adminId     Int
  admin       User       @relation("AdminTasks", fields: [adminId], references: [id], onDelete: Cascade)
  
  internId    Int
  intern      User       @relation("InternTasks", fields: [internId], references: [id], onDelete: Cascade)
}

// 4. GİRİŞ LOGLARI TABLOSU (YENİ)
model DailyLog {
  id          Int       @id @default(autoincrement())
  loginTime   DateTime  @default(now())
  logoutTime  DateTime?

  internId    Int
  intern      User      @relation("InternLogs", fields: [internId], references: [id], onDelete: Cascade)
}

// 5. GÜNLÜK ARŞİV TABLOSU (YENİ)
model DailyArchive {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text // Uzun metinler (günün özeti) için Text tipi
  date      DateTime @default(now())

  internId  Int
  intern    User     @relation("InternArchives", fields: [internId], references: [id], onDelete: Cascade)
}

// 6. MESAJLAŞMA TABLOSU (YENİ)
model Message {
  id          Int      @id @default(autoincrement())
  content     String   @db.Text
  timestamp   DateTime @default(now())

  senderId    Int
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId  Int
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
}

// YENİ TABLO: AI Raporları
model AiReport {
  id             Int      @id @default(autoincrement())
  internId       Int
  reportDate     DateTime @default(now())
  
  // AI Analiz Sonuçları
  overallScore   Int      // 0-100 arası performans puanı
  strengths      String[] // Güçlü yönler (PostgreSQL Array)
  weaknesses     String[] // Geliştirilmesi gereken alanlar
  suggestions    String[] // Mentör tavsiyeleri
  adminSummary   String   @db.Text // Admin paneli için özet metin
  rawJson        Json     // Gemini'den dönen orijinal JSON (Debug/Audit için)

  // İlişki
  intern         User     @relation("InternAiReports", fields: [internId], references: [id], onDelete: Cascade)
}