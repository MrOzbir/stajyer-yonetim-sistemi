generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- KULLANICI ROLLERİ ---
enum Role {
  ADMIN
  INTERN
}

// --- GÖREV DURUMLARI ---
enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

// 1. KULLANICILAR TABLOSU (Güncellendi)
model User {
  id             Int                 @id @default(autoincrement())
  email          String              @unique
  name           String
  surname        String              @default("")
  password_hash  String	
  role           Role                @default(INTERN)
  createdAt      DateTime            @default(now())
  
  archiveEntries     DailyArchiveEntry[] @relation("InternArchiveEntries")

  // SOFT DELETE
  isArchived     Boolean             @default(false)
  archivedAt     DateTime?

  // Mevcut İlişkiler
  tasksGiven     Task[]              @relation("AdminTasks")
  tasksReceived  Task[]              @relation("InternTasks")

  // Log ve Mesajlaşma İlişkileri (Eski 'archives' satırı silindi)
  logs           DailyLog[]          @relation("InternLogs")
  sentMessages   Message[]           @relation("SentMessages")
  receivedMessages Message[]         @relation("ReceivedMessages")

  aiReports      AiReport[]          @relation("InternAiReports")
  internProfile  InternProfile?

  // DEPARTMAN İLİŞKİSİ
  departmentId   Int?
  department     Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
}

// 2. STAJYER PROFİLİ TABLOSU
model InternProfile {
  id         Int       @id @default(autoincrement())
  university String?
  major      String?
  startDate  DateTime?
  endDate    DateTime?

  notificationEmail String?

  userId     Int       @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 3. GÖREVLER TABLOSU
model Task {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  deadline      DateTime?
  repoLink    String?    // YENİ: Stajyerin ekleyeceği Github/Gitlab linki
  status      TaskStatus @default(PENDING)
  createdAt   DateTime   @default(now())

  adminId     Int
  admin       User       @relation("AdminTasks", fields: [adminId], references: [id], onDelete: Cascade)
  
  internId    Int
  intern      User       @relation("InternTasks", fields: [internId], references: [id], onDelete: Cascade)
}

// 4. GİRİŞ LOGLARI TABLOSU (YENİ)
model DailyLog {
  id          Int       @id @default(autoincrement())
  loginTime   DateTime  @default(now())
  logoutTime  DateTime?

  internId    Int
  intern      User      @relation("InternLogs", fields: [internId], references: [id], onDelete: Cascade)

  nextDayTip   String?  
  nextDayQuote String?
}

// 5. HAM METİN TUTMAYAN ANONİM GÜNLÜK İSTATİSTİK TABLOSU
model DailyArchiveEntry {
  id                 Int      @id @default(autoincrement())
  date               DateTime @db.Date @default(now())
  internId           Int
  intern             User     @relation("InternArchiveEntries", fields: [internId], references: [id], onDelete: Cascade)

  // AI tarafından çıkarılan yapılandırılmış anonim veriler
  mood               String
  topicsCovered      String[]
  challengesFaced    String[]
  socialInteractions String[]
  sentimentScore     Int
}

// 6. Adminlerin gördüğü genel havuz özeti tablosu
model DailySummary {
  id               Int      @id @default(autoincrement())
  date             DateTime @default(now())
  
  generalMoral     String   
  challenges       String[] 
  achievements     String[] 
  complaints       String[] 
  satisfactions    String[] 
  executiveSummary String   @db.Text
}

// 7. MESAJLAŞMA TABLOSU
model Message {
  id          Int       @id @default(autoincrement())
  content     String    @db.Text
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  
  senderId    Int
  sender      User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  
  receiverId  Int
  receiver    User      @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
}

// 8. AI Raporları
model AiReport {
  id             Int      @id @default(autoincrement())
  internId       Int
  reportDate     DateTime @default(now())
  
  // ORTAK ALANLAR (Admin + Stajyer görür)
  overallScore   Int      
  strengths      String[] 
  
  // SADECE ADMIN GÖRÜR (Stajyerden gizli)
  weaknesses     String[] 
  adminSummary   String   @db.Text
  
  // ORTAK ÖNERİLER
  suggestions    String[] 
  
  // 🆕 SADECE STAJYER GÖRÜR (Mentörlük Alanları)
  internSummary      String   @db.Text   // Motive edici, pozitif özet
  internFeedback     String   @db.Text   // Geliştirici geri bildirim
  learningResources  String[] @default([]) // ["React Hooks - MDN", "Clean Code - Kitap"]
  nextSteps          String[] @default([]) // Somut eylem planı
  encouragementQuote String?  // Günlük motivasyon sözü
  
  // Orijinal JSON (audit)
  rawJson        Json     

  intern         User     @relation("InternAiReports", fields: [internId], references: [id], onDelete: Cascade)
}

// 9. DEPARTMAN MODELİ
model Department {
  id          Int      @id @default(autoincrement())
  name        String   @unique           // Departman adı (benzersiz)
  description String?  @db.Text          // Opsiyonel açıklama
  color       String   @default("#0084ff") // UI'da kullanılacak renk kodu
  createdAt   DateTime @default(now())

  // 🔄 İLİŞKİ: Bu departmana bağlı kullanıcılar
  members     User[]
}